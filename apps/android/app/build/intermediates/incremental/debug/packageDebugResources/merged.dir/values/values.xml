<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="solcity_navy">#FF061B3A</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Sol City</string>
    <string name="load_error_retry">Retry</string>
    <string name="load_error_title">Can\'t reach the city</string>
    <style name="Theme.SolCity" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/solcity_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.SolCity.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/solcity_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/solcity_navy</item>
        <item name="postSplashScreenTheme">@style/Theme.SolCity</item>
    </style>
</resources>