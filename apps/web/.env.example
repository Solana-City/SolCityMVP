# Jupiter Swap V2 API key (free at https://developers.jup.ag/portal)
# Optional for devnet testing, required for mainnet production
NEXT_PUBLIC_JUPITER_API_KEY=

# Network: "devnet" or "mainnet-beta"
NEXT_PUBLIC_NETWORK=devnet

# Sol City program ID (after anchor deploy)
NEXT_PUBLIC_SOL_CITY_PROGRAM_ID=11111111111111111111111111111111

# Sol Mechs PvP program ID (programs/sol-mechs, deployed through Solana
# Playground). Leave empty to run PvP between two tabs of one browser.
NEXT_PUBLIC_SOLMECHS_PROGRAM=
