{
  "name": "solana-city",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "map:embed": "node apps/web/scripts/embed-tiled-map.mjs",
    "map:collision": "node apps/web/scripts/patch-map-collision.mjs",
    "test": "npm run test -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "programs:build": "bash scripts/build-programs.sh",
    "programs:verify": "node scripts/verify-sbpf.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@metaplex-foundation/umi": "0.9.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jimp": "^1.6.1",
    "pngjs": "^7.0.0"
  }
}
